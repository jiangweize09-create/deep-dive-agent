# live 模式 LLM 配置：复制本文件为 .env 并填写。
# 这份是后端读取的唯一配置来源；前端面板仅作临时覆盖，留空即用这里。
# 任何 OpenAI 兼容端点均可，示例：
#   DeepSeek  https://api.deepseek.com/v1                          model: deepseek-v4-flash
#   通义千问   https://dashscope.aliyuncs.com/compatible-mode/v1     model: qwen-max
#   智谱 GLM  https://open.bigmodel.cn/api/paas/v4                 model: glm-4.6
#   Moonshot  https://api.moonshot.cn/v1                            model: moonshot-v1-128k
# 注意：deepseek-chat / deepseek-reasoner 旧别名已停用，请用 deepseek-v4-flash / deepseek-v4-pro。
XIHUANG_LLM_BASE_URL=
XIHUANG_LLM_API_KEY=
XIHUANG_LLM_MODEL=

# 单轮最大工具调用轮数 / 查询行数上限
XIHUANG_MAX_STEPS=8

# 语音输入（可选，不填只是麦克风提示未配置，问答主链路照常跑）
# 阿里云百炼 Paraformer-v2（按量计费，价格与免费额度以百炼官网为准，正常使用开销很低）。
# 获取 key：百炼控制台 → API-KEY 管理。
# 留空则不启用语音；也可用 DASHSCOPE_API_KEY 代替（本项目其他用途同key）。
XIHUANG_ASR_API_KEY=
XIHUANG_ASR_MODEL=paraformer-v2
# 单次录音时长上限（秒）与音频体积上限（字节），前端到点自动停止
XIHUANG_ASR_MAX_SECONDS=60
XIHUANG_ASR_MAX_BYTES=10485760
